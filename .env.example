# ─── Daysheet environment ───────────────────────────────────────────────────────
# Copy to .env at the repo root. Every app reads this one file.
# Nothing here is required to run the UI with the seed data except DATABASE_URL.
# Integrations degrade to labeled simulators when their keys are absent.

NODE_ENV=development
APP_NAME=Daysheet
WEB_URL=http://localhost:3100
TRUST_PROXY=off             # on behind a platform's proxy (Render, Fly), so rate limits see the client's address
API_URL=http://localhost:3101
API_PORT=3101

# PostgreSQL 17 (local install or `docker compose up db`)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/daysheet?schema=public

# Redis 7 for BullMQ (`docker compose up redis`); the machine's default 6379 may be an old Redis.
# Leave it empty for one process without Redis: jobs run inline from the ledger, cache and rate limits in memory.
REDIS_URL=redis://127.0.0.1:6380

# Shared secret between the web app's session and the API (any long random string)
AUTH_SECRET=change-me-to-a-long-random-string

# Anthropic — required for Ask. Without it, Ask answers with a labeled offline stub.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_JUDGE_MODEL=claude-haiku-4-5
ASK_MONTHLY_SPEND_CAP_CENTS=3000
# Which model answers Ask: auto (the Anthropic key, else a hosted OpenAI-style endpoint with a key, else a local Ollama
# server, else offline), or anthropic / openai / ollama / offline to insist.
# A local model costs nothing: `ollama pull qwen2.5:7b-instruct` (4.7 GB; tool calling; fits a 6 GB GPU).
# A hosted free tier (Groq, OpenRouter's free models, Google's compatibility endpoint) needs its base URL, a key you paste, and a model name.
ASK_PROVIDER=auto
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_NUM_CTX=8192

# Stripe — TEST MODE keys only (sk_test_… / whsec_…). Never a live key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# QuickBooks Online — sandbox app credentials from developer.intuit.com. Leave blank for the simulator.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3101/integrations/qbo/callback
QBO_ENVIRONMENT=sandbox
# Fault injection for the simulator, e.g. "429x2" = first two calls are throttled
QBO_SIM_FAULTS=

# Twilio — test credentials. Leave blank for the simulator (messages are logged, not sent).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_INTAKE_NUMBER=

# Resend — for the owner digest email. Leave blank for the simulator.
RESEND_API_KEY=
DIGEST_FROM_EMAIL=daysheet@example.com

# Sentry (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Demo behaviour
DEMO_CLOCK=            # ISO date to freeze "today" for demos, e.g. 2026-04-20
SEED=20260916          # deterministic seed for synthetic data
