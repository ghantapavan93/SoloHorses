{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "Daysheet API — NestJS + Prisma + BullMQ. Owns all database access, integrations, jobs, and the assistant.",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "eval": "node scripts/run-evals.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.126.0",
    "@dagrejs/dagre": "3.1.1",
    "@daysheet/db": "workspace:*",
    "@daysheet/domain": "workspace:*",
    "@langchain/langgraph": "1.4.15",
    "@langchain/langgraph-checkpoint-postgres": "1.0.5",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/swagger": "11.4.7",
    "@sentry/nestjs": "10.75.0",
    "bcryptjs": "3.0.3",
    "bullmq": "5.81.5",
    "helmet": "8.3.0",
    "intuit-oauth": "4.2.5",
    "ioredis": "5.11.1",
    "nestjs-pino": "5.2.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "resend": "6.28.1",
    "rxjs": "7.8.2",
    "stripe": "22.6.2",
    "twilio": "6.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.5",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.3",
    "@types/supertest": "7.2.1",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "jest": "30.5.1",
    "pg": "8.23.0",
    "pino-pretty": "13.1.3",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "globalSetup": "<rootDir>/test-support/global-setup.ts",
    "maxWorkers": 1,
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "isolatedModules": true
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.spec.ts",
      "!main.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
